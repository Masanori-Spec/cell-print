{
  "name": "cell-print",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline selected notebook source cells for print and source-only excerpts",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "fixture": "node scripts/generate-fixture.mjs",
    "test:browser": "playwright test",
    "verify": "npm run fixture && npm run build && npm test"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-draft-04": "1.0.0",
    "prismjs": "1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "esbuild": "0.25.10"
  }
}
